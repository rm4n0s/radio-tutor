  "captions": [
    {"start":0.6,"end":7.592,"text":"Όταν χρησιμοποιούμε μια συσκευή, η ενέργεια αλλάζει μορφή. Όμως δεν αλλάζει πάντα σε μορφή που μας χρειάζεται."},
    {"start":8.392,"end":15.144,"text":"Ας δούμε ένα φορτηγό. Το πετρέλαιο στη δεξαμενή του έχει χημική ενέργεια, που τη χρησιμοποιούμε εύκολα."},
    {"start":16.144,"end":24.096,"text":"Η μηχανή κάνει το φορτηγό να κινείται. Όμως ένα μέρος της ενέργειας γίνεται θερμότητα, στη μηχανή και στα λάστιχα που τρίβονται στον δρόμο."},
    {"start":25.096,"end":30.424,"text":"Αυτή τη θερμότητα δεν μπορούμε να τη χρησιμοποιήσουμε εύκολα. Σκορπίζεται στον αέρα γύρω μας."},
    {"start":31.424,"end":38.672,"text":"Λέμε ότι η ενέργεια υποβαθμίστηκε. Υποβάθμιση είναι η μετατροπή της ενέργειας σε μορφές που δεν μπορούμε να αξιοποιήσουμε."},
    {"start":40.172,"end":46.236,"text":"Το ίδιο συμβαίνει και με έναν ανεμιστήρα. Παίρνει ηλεκτρική ενέργεια, που τη χρησιμοποιούμε εύκολα."},
    {"start":47.236,"end":54.244,"text":"Τα πτερύγια γυρίζουν, αλλά ο ανεμιστήρας ζεσταίνεται λίγο. Ένα μέρος της ενέργειας υποβαθμίζεται σε θερμότητα."},
    {"start":55.744,"end":60.096,"text":"Τώρα φαντάσου ένα ποδήλατο ανάποδα, πάνω σε ένα θρανίο, με ένα λαμπάκι."},
    {"start":60.896,"end":67.648,"text":"Στη ρόδα ακουμπάει ο δυναμό. Είναι μια μικρή συσκευή, που μετατρέπει την κίνηση της ρόδας σε ηλεκτρική ενέργεια."},
    {"start":68.648,"end":72.648,"text":"Όταν η δασκάλα γυρίζει τη ρόδα αργά, το λαμπάκι φωτίζει λίγο."},
    {"start":73.648,"end":77.472,"text":"Όταν τη γυρίζει γρήγορα, το λαμπάκι φωτίζει πολύ περισσότερο."},
    {"start":78.472,"end":84.168,"text":"Η κινητική ενέργεια της ρόδας γίνεται ηλεκτρική στον δυναμό, και μετά φωτεινή στο λαμπάκι."},
    {"start":85.368,"end":90.92,"text":"Και εδώ ένα μέρος της ενέργειας γίνεται θερμότητα, γιατί ο δυναμό και το λαμπάκι ζεσταίνονται."},
    {"start":92.12,"end":100.008,"text":"Κάθε φορά που η ενέργεια αλλάζει μορφή, ένα μέρος της καταλήγει ως θερμότητα. Γι’ αυτό λέμε ότι η ενέργεια υποβαθμίζεται."},
    {"start":101.508,"end":106.084,"text":"Τα φωτοβολταϊκά πάνελ μετατρέπουν τη φωτεινή ενέργεια του Ήλιου σε ηλεκτρική."},
    {"start":107.084,"end":114.668,"text":"Η ηλεκτρική ενέργεια μπορεί μετά να γυρίσει ένα μικρό ανεμιστηράκι. Η φωτεινή ενέργεια γίνεται ηλεκτρική, και μετά κινητική."},
    {"start":116.168,"end":125.032,"text":"Στο σπίτι μας, ο μετρητής της ΔΕΗ δεν μετράει ενέργεια που χάνεται. Μετράει την ενέργεια που μετατρέπεται και υποβαθμίζεται σε θερμότητα."},
    {"start":126.032,"end":130.096,"text":"Η ΔΕΗ μας χρεώνει γι’ αυτή την ποσότητα της ενέργειας."},
    {"start":131.096,"end":138.728,"text":"Η συνολική ενέργεια διατηρείται, αλλά η χρήσιμη ενέργεια λιγοστεύει. Γι’ αυτό τη χρησιμοποιούμε με προσοχή."}
  ]
}
