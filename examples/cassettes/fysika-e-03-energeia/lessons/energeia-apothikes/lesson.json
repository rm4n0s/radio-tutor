  "captions": [
    {"start":0.6,"end":6.648,"text":"Ξέρεις τι είναι μια αποθήκη; Είναι ένας χώρος, όπου φυλάμε πράγματα για να τα χρησιμοποιήσουμε αργότερα."},
    {"start":7.448,"end":12.984,"text":"Και η ενέργεια μπορεί να αποθηκευτεί! Τις αποθήκες της ενέργειας τις λέμε πηγές ενέργειας."},
    {"start":13.984,"end":17.312,"text":"Η φύση έχει φτιάξει πολλές τέτοιες αποθήκες."},
    {"start":18.112,"end":23.088,"text":"Ο Ήλιος μας στέλνει φωτεινή ενέργεια, και τα φυτά τη χρησιμοποιούν για να μεγαλώσουν."},
    {"start":24.288,"end":31.12,"text":"Το πετρέλαιο και τα κάρβουνα είναι αποθήκες χημικής ενέργειας. Η ενέργειά τους ήρθε από τον Ήλιο πριν από εκατομμύρια χρόνια."},
    {"start":32.32,"end":38.368,"text":"Το νερό που πέφτει ορμητικά από έναν καταρράκτη έχει κινητική ενέργεια, και μπορεί να γυρίσει έναν νερόμυλο."},
    {"start":39.868,"end":44.748,"text":"Κάποιες φορές αποθηκεύουμε εμείς την ενέργεια, για να τη χρησιμοποιήσουμε αργότερα."},
    {"start":45.748,"end":48.82,"text":"Η μπαταρία έχει αποθηκευμένη χημική ενέργεια."},
    {"start":49.42,"end":54.796,"text":"Όταν τη συνδέσουμε με ένα λαμπάκι, η ενέργειά της γίνεται ηλεκτρική και μετά φωτεινή."},
    {"start":56.296,"end":61.4,"text":"Μπαταρίες έχουν οι φακοί, τα τηλεχειριστήρια, τα ρολόγια και πολλά παιχνίδια."},
    {"start":62.4,"end":66.72,"text":"Ένα ελατήριο που το πιέζουμε ή το τεντώνουμε, αποθηκεύει δυναμική ενέργεια."},
    {"start":67.72,"end":72.152,"text":"Όταν κουρδίζουμε ένα παιχνίδι, αποθηκεύουμε ενέργεια στο ελατήριό του."},
    {"start":73.152,"end":80.112,"text":"Μετά το ελατήριο ξετυλίγεται σιγά σιγά, και η ενέργεια γίνεται κινητική. Το παιχνίδι κινείται!"},
    {"start":81.612,"end":87.18,"text":"Και το αυτοκίνητο έχει μια αποθήκη: τη δεξαμενή με τη βενζίνη, που κρύβει χημική ενέργεια."},
    {"start":88.68,"end":94.936,"text":"Είναι όμως η ενέργεια ανεξάντλητη; Όχι! Οι αποθήκες της Γης με χρήσιμη ενέργεια έχουν όριο."},
    {"start":95.936,"end":100.032,"text":"Όταν μετατρέπουμε πολλή ενέργεια, επιβαρύνουμε και το περιβάλλον."},
    {"start":100.832,"end":104.432,"text":"Γι’ αυτό πρέπει να χρησιμοποιούμε την ενέργεια σωστά και με μέτρο."},
    {"start":105.932,"end":111.868,"text":"Θυμήσου μια πολύ σημαντική αρχή: η ενέργεια δεν εμφανίζεται από το τίποτα, ούτε εξαφανίζεται."},
    {"start":112.868,"end":118.468,"text":"Δεν μπορούμε να τη δημιουργήσουμε. Μπορούμε όμως να την αποθηκεύσουμε και να την αλλάξουμε σε άλλη μορφή."},
    {"start":119.468,"end":122.988,"text":"Η ενέργεια που χρησιμοποιούμε έρχεται πάντα από μια αποθήκη."}
  ]
}
