  "captions": [
    {"start":0.6,"end":6.648,"text":"Ξέρεις τι είναι μια αποθήκη; Είναι ένας χώρος, όπου φυλάμε πράγματα για να τα χρησιμοποιήσουμε αργότερα."},
    {"start":7.448,"end":12.984,"text":"Και η ενέργεια μπορεί να αποθηκευτεί! Τις αποθήκες της ενέργειας τις λέμε πηγές ενέργειας."},
    {"start":13.984,"end":17.312,"text":"Η φύση έχει φτιάξει πολλές τέτοιες αποθήκες."},
    {"start":18.112,"end":23.088,"text":"Ο Ήλιος μας στέλνει φωτεινή ενέργεια, και τα φυτά τη χρησιμοποιούν για να μεγαλώσουν."},
    {"start":24.288,"end":31.12,"text":"Το πετρέλαιο και τα κάρβουνα είναι αποθήκες χημικής ενέργειας. Η ενέργειά τους ήρθε από τον Ήλιο πριν από εκατομμύρια χρόνια."},
    {"start":32.32,"end":37.808,"text":"Το νερό που πέφτει ορμητικά από έναν καταρράκτη έχει κινητική ενέργεια, και μπορεί να κινήσει μηχανές."},
    {"start":38.808,"end":41.384,"text":"Και ο άνεμος που φυσάει έχει κινητική ενέργεια."},
    {"start":42.884,"end":47.572,"text":"Κάποιες φορές αποθηκεύουμε εμείς την ενέργεια, για να τη χρησιμοποιήσουμε αργότερα."},
    {"start":48.572,"end":51.58,"text":"Η μπαταρία έχει αποθηκευμένη χημική ενέργεια."},
    {"start":52.18,"end":57.476,"text":"Όταν τη συνδέσουμε με ένα λαμπάκι, η ενέργειά της γίνεται ηλεκτρική και μετά φωτεινή."},
    {"start":58.976,"end":63.696,"text":"Μπαταρίες έχουν οι φακοί, τα τηλεχειριστήρια, τα ρολόγια και πολλά παιχνίδια."},
    {"start":64.696,"end":69.16,"text":"Ένα ελατήριο που το πιέζουμε ή το τεντώνουμε, αποθηκεύει δυναμική ενέργεια."},
    {"start":70.16,"end":74.736,"text":"Όταν κουρδίζουμε ένα παιχνίδι, αποθηκεύουμε ενέργεια στο ελατήριό του."},
    {"start":75.736,"end":83.144,"text":"Μετά το ελατήριο ξετυλίγεται σιγά σιγά, και η ενέργεια γίνεται κινητική. Το παιχνίδι κινείται!"},
    {"start":84.644,"end":90.196,"text":"Και το αυτοκίνητο έχει μια αποθήκη: τη δεξαμενή με τη βενζίνη, που κρύβει χημική ενέργεια."},
    {"start":91.696,"end":98.368,"text":"Είναι όμως η ενέργεια ανεξάντλητη; Όχι! Οι αποθήκες της Γης με χρήσιμη ενέργεια έχουν όριο."},
    {"start":99.368,"end":103.384,"text":"Όταν μετατρέπουμε πολλή ενέργεια, επιβαρύνουμε και το περιβάλλον."},
    {"start":104.184,"end":107.704,"text":"Γι’ αυτό πρέπει να χρησιμοποιούμε την ενέργεια σωστά και με μέτρο."},
    {"start":109.204,"end":115.076,"text":"Θυμήσου μια πολύ σημαντική αρχή: η ενέργεια δεν εμφανίζεται από το τίποτα, ούτε εξαφανίζεται."},
    {"start":116.076,"end":121.708,"text":"Δεν μπορούμε να τη δημιουργήσουμε. Μπορούμε όμως να την αποθηκεύσουμε και να την αλλάξουμε σε άλλη μορφή."},
    {"start":122.708,"end":126.196,"text":"Η ενέργεια που χρησιμοποιούμε έρχεται πάντα από μια αποθήκη."}
  ]
}
