  "captions": [
    {"start":0.6,"end":9.4,"text":"Γεια σου! Σήμερα θα γνωρίσουμε μια πολύ σημαντική λέξη: την ενέργεια."},
    {"start":10.0,"end":16.448,"text":"Ένα φύλλο πέφτει, ένα αυτοκίνητο τρέχει, ένα φως ανάβει. Σε όλα αυτά κάτι αλλάζει."},
    {"start":17.648,"end":21.696,"text":"Για κάθε αλλαγή που γίνεται στη φύση, χρειάζεται ενέργεια."},
    {"start":22.196,"end":24.676,"text":"Χωρίς ενέργεια, δεν αλλάζει τίποτα!"},
    {"start":26.176,"end":31.056,"text":"Εδώ και χιλιάδες χρόνια, οι άνθρωποι προσπαθούν να χρησιμοποιήσουν την ενέργεια."},
    {"start":31.656,"end":35.624,"text":"Πρώτα έμαθαν να ανάβουν φωτιά, για να ζεσταθούν και να φωτίζουν τη νύχτα."},
    {"start":36.624,"end":41.872,"text":"Ύστερα έφτιαξαν ανεμόμυλους και νερόμυλους, που παίρνουν ενέργεια από τον άνεμο και το νερό."},
    {"start":43.072,"end":48.064,"text":"Σήμερα έχουμε πολύπλοκες συσκευές, που αλλάζουν την ενέργεια από τη μία μορφή στην άλλη."},
    {"start":49.064,"end":53.288,"text":"Η ενέργεια έχει πολλά πρόσωπα. Τα πρόσωπα αυτά τα λέμε μορφές ενέργειας."},
    {"start":54.488,"end":58.872,"text":"Η ενέργεια που είναι κρυμμένη στις τροφές και στα καύσιμα, λέγεται χημική ενέργεια."},
    {"start":59.372,"end":63.852,"text":"Για παράδειγμα, το ψωμί, η μπαταρία και το πετρέλαιο έχουν χημική ενέργεια."},
    {"start":64.852,"end":70.34,"text":"Η ενέργεια που ταξιδεύει μέσα στα καλώδια ενός κυκλώματος, λέγεται ηλεκτρική ενέργεια."},
    {"start":71.34,"end":74.428,"text":"Η ενέργεια του φωτός λέγεται φωτεινή ενέργεια."},
    {"start":75.428,"end":80.532,"text":"Όταν η ενέργεια περνάει από ένα ζεστό σώμα σε ένα πιο κρύο, τη λέμε θερμότητα."},
    {"start":81.532,"end":86.652,"text":"Όταν στα βάθη ενός ατόμου σπάει ο πυρήνας του, ελευθερώνεται πυρηνική ενέργεια."},
    {"start":87.652,"end":92.612,"text":"Ένα σώμα που κινείται, για παράδειγμα ένα παιδί που τρέχει, έχει κινητική ενέργεια."},
    {"start":93.612,"end":98.684,"text":"Ένα σώμα που το πιέζουν ή το τραβούν, όπως ένα ελατήριο, έχει δυναμική ενέργεια."},
    {"start":99.884,"end":104.636,"text":"Η κινητική και η δυναμική ενέργεια είναι οι δύο βασικές μορφές της ενέργειας."},
    {"start":106.136,"end":109.928,"text":"Τώρα ξέρεις επτά μορφές ενέργειας. Μπορείς να τις βρεις γύρω σου;"}
  ]
}
