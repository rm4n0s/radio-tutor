  "captions": [
    {"start":0.6,"end":6.056,"text":"Έχεις νιώσει ποτέ πείνα, και να μην έχεις διάθεση για παιχνίδι; Σου έλειπε ενέργεια!"},
    {"start":6.856,"end":12.824,"text":"Το σώμα μας είναι ένας ακούραστος μετατροπέας ενέργειας. Την ενέργεια που χρειαζόμαστε την παίρνουμε από τις τροφές."},
    {"start":13.824,"end":20.144,"text":"Στις τροφές υπάρχει αποθηκευμένη χημική ενέργεια. Όταν τις χωνεύουμε, η ενέργεια αυτή ελευθερώνεται."},
    {"start":21.344,"end":25.136,"text":"Στη συνέχεια, το σώμα την αλλάζει σε άλλες μορφές ενέργειας."},
    {"start":25.936,"end":28.864,"text":"Σε θερμότητα, για να μένει ζεστό το σώμα μας."},
    {"start":30.064,"end":34.016,"text":"Σε κινητική ενέργεια, όταν τρέχουμε, περπατάμε ή γράφουμε."},
    {"start":35.216,"end":39.76,"text":"Σε ηλεκτρική ενέργεια, για να στέλνει ο εγκέφαλος μηνύματα σε όλο το σώμα."},
    {"start":40.96,"end":45.84,"text":"Και σε χημική ενέργεια, για να χτίζονται καινούργια κύτταρα και να αποθηκεύεται λίπος."},
    {"start":47.34,"end":51.404,"text":"Οι διαφορετικές τροφές μάς δίνουν διαφορετική ποσότητα ενέργειας."},
    {"start":52.404,"end":58.532,"text":"Στη συσκευασία πολλών τροφών γράφει πόση ενέργεια έχουν. Η ενέργεια μετριέται σε κιλοτζάουλ."},
    {"start":59.532,"end":66.14,"text":"Παλιότερα χρησιμοποιούσαν τις χιλιοθερμίδες. Μία χιλιοθερμίδα είναι περίπου τέσσερα κόμμα δύο κιλοτζάουλ."},
    {"start":67.34,"end":71.5,"text":"Το λάδι και η σοκολάτα έχουν πολλή ενέργεια. Τα μήλα και η σαλάτα έχουν λίγη."},
    {"start":73.0,"end":79.656,"text":"Δεν χρειάζονται όλοι την ίδια ενέργεια. Όσο περισσότερο κινούμαστε, τόσο περισσότερη ενέργεια χρειαζόμαστε."},
    {"start":80.656,"end":86.496,"text":"Ένας αθλητής που προπονείται πολλές ώρες, χρειάζεται πολύ περισσότερη ενέργεια από έναν υπάλληλο γραφείου."},
    {"start":87.696,"end":93.664,"text":"Ακόμα και όταν κάθεσαι, χρειάζεσαι ενέργεια, για να αναπνέεις και για να χτυπάει η καρδιά σου."},
    {"start":95.164,"end":104.188,"text":"Αν παίρνουμε από τις τροφές περισσότερη ενέργεια από όση χρειαζόμαστε, το σώμα αποθηκεύει την ενέργεια που περισσεύει, σε μορφή λίπους. Παχαίνουμε!"},
    {"start":105.388,"end":114.028,"text":"Αν παίρνουμε λιγότερη, το σώμα χρησιμοποιεί το λίπος σαν αποθήκη, και αδυνατίζουμε. Όμως οι εξαντλητικές δίαιτες είναι επικίνδυνες για την υγεία."},
    {"start":115.228,"end":121.948,"text":"Η σωστή διατροφή δίνει κάθε μέρα όση ενέργεια χρειαζόμαστε, ούτε περισσότερη, ούτε λιγότερη."},
    {"start":123.448,"end":128.792,"text":"Σκέψου πόσο κινήθηκες σήμερα, και τι έφαγες. Πήρες την ενέργεια που χρειάζεσαι;"}
  ]
}
