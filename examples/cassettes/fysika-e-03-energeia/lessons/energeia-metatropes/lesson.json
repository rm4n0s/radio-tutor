  "captions": [
    {"start":0.6,"end":5.144,"text":"Όλες οι συσκευές που χρησιμοποιούμε χρειάζονται ενέργεια, για να λειτουργήσουν."},
    {"start":5.944,"end":11.784,"text":"Κάθε συσκευή αλλάζει την ενέργεια από μία μορφή σε μία άλλη. Γι’ αυτό τη λέμε μετατροπέα ενέργειας."},
    {"start":12.784,"end":19.2,"text":"Ας δούμε ένα πείραμα με ένα ελατήριο. Το πιέζουμε και το κρατάμε. Έχει αποθηκευμένη δυναμική ενέργεια."},
    {"start":20.2,"end":25.32,"text":"Μπροστά του υπάρχει ένα μικρό χάρτινο μπαλάκι. Τώρα αφήνουμε το ελατήριο απότομα."},
    {"start":26.02,"end":31.524,"text":"Το ελατήριο τινάζεται και σπρώχνει το μπαλάκι μακριά! Η δυναμική ενέργεια έγινε κινητική."},
    {"start":33.024,"end":41.984,"text":"Ας δούμε και ένα κύκλωμα, με μια μπαταρία, καλώδια και ένα λαμπάκι. Το λαμπάκι φωτοβολεί."},
    {"start":42.984,"end":49.512,"text":"Η χημική ενέργεια της μπαταρίας γίνεται ηλεκτρική στα καλώδια, και μετά φωτεινή στο λαμπάκι."},
    {"start":50.512,"end":56.416,"text":"Αν αποσυνδέσουμε την μπαταρία, το λαμπάκι σβήνει. Χωρίς ενέργεια, δεν γίνεται καμία αλλαγή!"},
    {"start":57.916,"end":63.564,"text":"Για να σημειώνουμε τις αλλαγές, γράφουμε: από ποια μορφή ενέργειας, σε ποια μορφή ενέργειας."},
    {"start":64.764,"end":68.796,"text":"Ο ηλεκτρικός ανεμιστήρας μετατρέπει την ηλεκτρική ενέργεια σε κινητική."},
    {"start":69.996,"end":74.092,"text":"Το καμινέτο μετατρέπει τη χημική ενέργεια σε θερμότητα και φως."},
    {"start":75.292,"end":80.412,"text":"Το αυτοκίνητο μετατρέπει τη χημική ενέργεια της βενζίνης σε κινητική ενέργεια και θερμότητα."},
    {"start":81.612,"end":86.556,"text":"Το κουρδισμένο παιχνίδι μετατρέπει τη δυναμική ενέργεια του ελατηρίου σε κινητική."},
    {"start":88.056,"end":96.264,"text":"Σε μεγάλα εργοστάσια η ενέργεια μετατρέπεται σε ηλεκτρική, και ταξιδεύει μέσα από τα καλώδια της ΔΕΗ μέχρι το σπίτι μας."},
    {"start":97.764,"end":103.78,"text":"Μια σημαντική αρχή: η ενέργεια δεν χάνεται και δεν δημιουργείται, απλώς αλλάζει μορφή."},
    {"start":104.98,"end":109.252,"text":"Έτσι, η ενέργεια αλλάζει συνεχώς μορφή, γύρω μας και μέσα στη φύση."},
    {"start":110.252,"end":116.46,"text":"Πολλές φορές οι αλλαγές είναι ευεργετικές, όπως η βροχή, ο άνεμος και η ανάπτυξη των φυτών."},
    {"start":117.66,"end":123.228,"text":"Άλλες φορές είναι καταστροφικές, όπως μια πυρκαγιά, ένας σεισμός ή ένας τυφώνας."},
    {"start":124.428,"end":129.58,"text":"Μπορείς να βρεις μια συσκευή στο σπίτι σου και να πεις, από ποια μορφή σε ποια αλλάζει την ενέργεια;"}
  ]
}
