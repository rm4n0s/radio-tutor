  "captions": [
    {
      "start": 0.5,
      "end": 5.93,
      "text": "Γεια σου! Σήμερα θα γνωρίσουμε τα μίγματα."
    },
    {
      "start": 6.23,
      "end": 11.0,
      "text": "Τα υλικά γύρω μας είναι δύο ειδών: καθαρές ουσίες και μίγματα."
    },
    {
      "start": 12.05,
      "end": 14.81,
      "text": "Ας ξεκινήσουμε με τις καθαρές ουσίες."
    },
    {
      "start": 15.11,
      "end": 18.14,
      "text": "Το αλουμίνιο στα παράθυρα είναι καθαρή ουσία."
    },
    {
      "start": 18.79,
      "end": 21.01,
      "text": "Το ίδιο και ο χαλκός στα σύρματα."
    },
    {
      "start": 21.66,
      "end": 23.65,
      "text": "Και ο υδράργυρος στο θερμόμετρο."
    },
    {
      "start": 24.3,
      "end": 27.74,
      "text": "Αυτές οι ουσίες λέγονται χημικά στοιχεία."
    },
    {
      "start": 28.59,
      "end": 31.54,
      "text": "Καθαρή ουσία είναι και το αποσταγμένο νερό."
    },
    {
      "start": 31.84,
      "end": 35.05,
      "text": "Τέτοιες ουσίες λέγονται χημικές ενώσεις."
    },
    {
      "start": 36.1,
      "end": 40.01,
      "text": "Τις περισσότερες φορές όμως τα υλικά δεν είναι καθαρές ουσίες."
    },
    {
      "start": 40.31,
      "end": 42.71,
      "text": "Είναι μίγματα."
    },
    {
      "start": 43.56,
      "end": 48.11,
      "text": "Όταν ανακατεύουμε δύο ή περισσότερες ουσίες, φτιάχνουμε ένα μίγμα."
    },
    {
      "start": 48.96,
      "end": 52.99,
      "text": "Οι ουσίες που ανακατεύουμε λέγονται συστατικά του μίγματος."
    },
    {
      "start": 54.34,
      "end": 56.28,
      "text": "Ας δούμε ένα αναψυκτικό."
    },
    {
      "start": 56.58,
      "end": 59.56,
      "text": "Στην ετικέτα του διαβάζουμε τα συστατικά του."
    },
    {
      "start": 60.31,
      "end": 61.95,
      "text": "Το νερό είναι υγρό."
    },
    {
      "start": 62.6,
      "end": 64.3,
      "text": "Η ζάχαρη είναι στερεή."
    },
    {
      "start": 64.95,
      "end": 67.82,
      "text": "Το διοξείδιο του άνθρακα είναι αέριο."
    },
    {
      "start": 68.57,
      "end": 72.26,
      "text": "Το αναψυκτικό είναι μίγμα από υγρό, στερεό και αέριο."
    },
    {
      "start": 73.61,
      "end": 76.99,
      "text": "Ένα μίγμα κρατάει τις ιδιότητες των συστατικών του."
    },
    {
      "start": 77.74,
      "end": 79.26,
      "text": "Το αλάτι είναι αλμυρό."
    },
    {
      "start": 79.91,
      "end": 83.84,
      "text": "Αν το ρίξουμε στο νερό, το αλατόνερο είναι κι αυτό αλμυρό."
    },
    {
      "start": 84.89,
      "end": 88.43,
      "text": "Η ζάχαρη είναι γλυκιά και ο καφές έχει σκούρο χρώμα."
    },
    {
      "start": 89.08,
      "end": 91.84,
      "text": "Ο καφές με ζάχαρη είναι σκούρος και γλυκός."
    },
    {
      "start": 93.19,
      "end": 95.82,
      "text": "Στην κουζίνα φτιάχνουμε συχνά μίγματα."
    },
    {
      "start": 96.12,
      "end": 101.2,
      "text": "Η σαλάτα, το λαδόξιδο, ο χυμός πορτοκαλιού και το τσάι είναι μίγματα."
    },
    {
      "start": 102.25,
      "end": 106.35,
      "text": "Μίγμα φτιάχνουμε όταν ανακατεύουμε δύο ή περισσότερες ουσίες."
    },
    {
      "start": 106.65,
      "end": 109.74,
      "text": "Στο επόμενο μάθημα θα δούμε πώς είναι τα μίγματα."
    }
  ]
}
