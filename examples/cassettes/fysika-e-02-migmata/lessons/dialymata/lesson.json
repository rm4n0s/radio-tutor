  "captions": [
    {
      "start": 0.5,
      "end": 5.0,
      "text": "Σε μερικά μίγματα δεν μπορούμε να δούμε τα συστατικά, ούτε με μικροσκόπιο."
    },
    {
      "start": 5.3,
      "end": 9.23,
      "text": "Τα λέμε ομογενή μίγματα, ή αλλιώς διαλύματα."
    },
    {
      "start": 10.08,
      "end": 12.88,
      "text": "Ρίχνουμε αλάτι στο νερό και ανακατεύουμε."
    },
    {
      "start": 13.18,
      "end": 16.45,
      "text": "Το αλάτι διαλύεται, και δεν το βλέπουμε πια."
    },
    {
      "start": 17.5,
      "end": 21.85,
      "text": "Το αλατόνερο, το κρασί και ο αέρας που αναπνέουμε είναι διαλύματα."
    },
    {
      "start": 23.2,
      "end": 26.87,
      "text": "Το συστατικό με τη μεγαλύτερη ποσότητα λέγεται διαλύτης."
    },
    {
      "start": 27.62,
      "end": 30.98,
      "text": "Τα υπόλοιπα συστατικά λέγονται διαλυμένες ουσίες."
    },
    {
      "start": 31.83,
      "end": 36.62,
      "text": "Στο τσάι με ζάχαρη, το νερό είναι ο διαλύτης και η ζάχαρη η διαλυμένη ουσία."
    },
    {
      "start": 37.97,
      "end": 40.28,
      "text": "Δεν είναι όλα τα διαλύματα υγρά."
    },
    {
      "start": 40.58,
      "end": 43.29,
      "text": "Ο καθαρός αέρας είναι ένα αέριο διάλυμα."
    },
    {
      "start": 43.94,
      "end": 46.91,
      "text": "Τα χρυσά κοσμήματα είναι στερεά διαλύματα."
    },
    {
      "start": 47.21,
      "end": 51.69,
      "text": "Φτιάχνονται από χρυσό ανακατεμένο με άλλο μέταλλο, συνήθως χαλκό."
    },
    {
      "start": 52.34,
      "end": 55.09,
      "text": "Τα μίγματα των μετάλλων λέγονται κράματα."
    },
    {
      "start": 55.84,
      "end": 59.33,
      "text": "Ο καθαρός χρυσός είναι πολύ μαλακός και φθείρεται γρήγορα."
    },
    {
      "start": 60.68,
      "end": 65.13,
      "text": "Το χάλκινο μετάλλιο είναι από μπρούντζο, ένα κράμα χαλκού και κασσίτερου."
    },
    {
      "start": 66.48,
      "end": 69.47,
      "text": "Μπορούμε να διαλύσουμε όση ζάχαρη θέλουμε στο τσάι;"
    },
    {
      "start": 70.22,
      "end": 76.03,
      "text": "Δεν μπορούμε. Αν ρίχνουμε συνέχεια ζάχαρη, κάποια στιγμή δεν διαλύεται πια."
    },
    {
      "start": 76.33,
      "end": 78.58,
      "text": "Κατακάθεται στον πάτο του ποτηριού."
    },
    {
      "start": 78.88,
      "end": 81.36,
      "text": "Αυτή η ποσότητα λέγεται ίζημα."
    },
    {
      "start": 82.71,
      "end": 87.85,
      "text": "Η ποσότητα που διαλύεται εξαρτάται από τον όγκο και τη θερμοκρασία του διαλύτη."
    },
    {
      "start": 88.7,
      "end": 93.53,
      "text": "Όσο περισσότερος είναι ο διαλύτης, τόσο περισσότερη ουσία διαλύεται."
    },
    {
      "start": 94.88,
      "end": 97.67,
      "text": "Και όσο πιο ζεστός είναι, τόσο περισσότερη."
    },
    {
      "start": 98.52,
      "end": 103.1,
      "text": "Στο ζεστό τσάι διαλύεται περισσότερη ζάχαρη απ' ό,τι στο κρύο."
    },
    {
      "start": 103.75,
      "end": 107.87,
      "text": "Προσοχή όμως: η πολλή ζάχαρη κάνει κακό στα δόντια."
    },
    {
      "start": 109.22,
      "end": 112.87,
      "text": "Όταν ζεσταίνεται το τσάι, τα μόρια κινούνται πιο γρήγορα."
    },
    {
      "start": 113.17,
      "end": 116.49,
      "text": "Έτσι ανακατεύονται πιο εύκολα με τα μόρια του διαλύτη."
    },
    {
      "start": 117.84,
      "end": 121.96,
      "text": "Το νερό είναι ο καλύτερος διαλύτης, και το λέμε παγκόσμιο διαλύτη."
    },
    {
      "start": 122.71,
      "end": 125.4,
      "text": "Διαλύει στερεά, υγρά και αέρια."
    },
    {
      "start": 126.25,
      "end": 129.6,
      "text": "Στη θάλασσα έχουν διαλυθεί αλάτι και οξυγόνο."
    },
    {
      "start": 130.35,
      "end": 134.07,
      "text": "Τα ψάρια παίρνουν το οξυγόνο από το νερό με τα βράγχιά τους."
    },
    {
      "start": 135.42,
      "end": 140.05,
      "text": "Το μόριο του νερού έχει δύο άτομα υδρογόνου και ένα άτομο οξυγόνου."
    },
    {
      "start": 141.4,
      "end": 145.07,
      "text": "Θυμήσου: στο διάλυμα δεν βλέπουμε τα συστατικά."
    },
    {
      "start": 145.37,
      "end": 148.3,
      "text": "Έχει έναν διαλύτη και διαλυμένες ουσίες."
    },
    {
      "start": 148.6,
      "end": 153.98,
      "text": "Διαλύεται περισσότερη ουσία όταν ο διαλύτης είναι πιο πολύς και πιο ζεστός."
    }
  ]
}
