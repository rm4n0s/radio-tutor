  "captions": [
    {"start":0.5,"end":4.724,"text":"Ποιο έχει μεγαλύτερη μάζα: ένα κυβάκι σίδερο ή ένα κυβάκι ξύλο;"},
    {"start":5.524,"end":9.844,"text":"Τα δύο κυβάκια έχουν το ίδιο μέγεθος, δηλαδή τον ίδιο όγκο."},
    {"start":10.644,"end":12.772,"text":"Τα βάζουμε στον ζυγό σύγκρισης."},
    {"start":13.772,"end":17.644,"text":"Ο δίσκος με το σίδερο κατεβαίνει! Το σίδερο έχει μεγαλύτερη μάζα."},
    {"start":18.644,"end":22.948,"text":"Με τον ίδιο όγκο, άλλα υλικά έχουν μεγάλη μάζα και άλλα μικρή."},
    {"start":23.948,"end":27.756,"text":"Λέμε ότι η ύλη του σιδήρου είναι πιο πυκνή από την ύλη του ξύλου."},
    {"start":28.956,"end":32.78,"text":"Η πυκνότητα μάς λέει πόση μάζα έχει ένα κυβικό εκατοστό από το υλικό."},
    {"start":33.78,"end":36.628,"text":"Τη μετράμε σε γραμμάρια ανά κυβικό εκατοστό."},
    {"start":37.628,"end":42.796,"text":"Ένα κυβικό εκατοστό νερό έχει μάζα ένα γραμμάριο. Άρα η πυκνότητα του νερού είναι ένα."},
    {"start":43.796,"end":47.828,"text":"Ένα κυβικό εκατοστό σίδηρο έχει μάζα επτά κόμμα οκτώ γραμμάρια."},
    {"start":48.828,"end":52.892,"text":"Ένα κυβικό εκατοστό χρυσό έχει μάζα δεκαεννιά κόμμα τρία γραμμάρια!"},
    {"start":53.892,"end":57.636,"text":"Ο φελλός, αντίθετα, έχει μόνο μηδέν κόμμα είκοσι τέσσερα."},
    {"start":58.836,"end":64.676,"text":"Όσο μεγαλύτερη είναι η πυκνότητα, τόσο περισσότερη ύλη χωράει σε κάθε κυβικό εκατοστό."},
    {"start":66.176,"end":72.208,"text":"Γι' αυτό ένα μεγάλο μαξιλάρι με πούπουλα μπορεί να έχει μεγαλύτερη μάζα από ένα μικρό σιδερένιο κλειδί."},
    {"start":73.408,"end":76.72,"text":"Και πώς βρίσκουμε τη μάζα, όταν ξέρουμε την πυκνότητα και τον όγκο;"},
    {"start":77.72,"end":81.88,"text":"Πολλαπλασιάζουμε! Δες δέκα κυβικά εκατοστά σίδηρο."},
    {"start":82.88,"end":86.272,"text":"Δέκα φορές επτά κόμμα οκτώ κάνουν εβδομήντα οκτώ γραμμάρια."},
    {"start":87.772,"end":92.076,"text":"Μέσα στα πυκνά υλικά, τα μόρια είναι πιο βαριά ή πιο κοντά το ένα στο άλλο."},
    {"start":93.576,"end":97.816,"text":"Ο φελλός έχει μικρότερη πυκνότητα από το νερό, και γι' αυτό επιπλέει."},
    {"start":98.816,"end":102.432,"text":"Ο σίδηρος έχει μεγαλύτερη πυκνότητα, και γι' αυτό βυθίζεται."},
    {"start":103.932,"end":108.956,"text":"Θυμήσου: όγκος, μάζα και πυκνότητα είναι οι βασικές ιδιότητες των υλικών σωμάτων."},
    {"start":109.956,"end":114.164,"text":"Μπράβο σου! Έλα στις ασκήσεις."}
  ]
}
