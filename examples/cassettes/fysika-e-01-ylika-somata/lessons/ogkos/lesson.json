  "captions": [
    {"start":0.5,"end":3.444,"text":"Δες ένα μικρό αυτοκίνητο και ένα μεγάλο φορτηγό."},
    {"start":3.844,"end":6.58,"text":"Ποιο από τα δύο χωράει περισσότερα κουτιά;"},
    {"start":8.08,"end":11.136,"text":"Φυσικά το φορτηγό, γιατί έχει περισσότερο χώρο."},
    {"start":11.936,"end":14.8,"text":"Ο χώρος που καταλαμβάνει ένα σώμα λέγεται όγκος."},
    {"start":15.8,"end":18.808,"text":"Κάθε σώμα, μικρό ή μεγάλο, έχει όγκο."},
    {"start":19.808,"end":22.816,"text":"Για να μετρήσουμε τον όγκο, χρειαζόμαστε μονάδες."},
    {"start":23.616,"end":29.072,"text":"Η βασική μονάδα είναι το κυβικό μέτρο: ο όγκος ενός κύβου, που κάθε ακμή του είναι ένα μέτρο."},
    {"start":30.572,"end":37.404,"text":"Για μικρότερα σώματα χρησιμοποιούμε το κυβικό εκατοστό, ένα μικροσκοπικό κυβάκι με ακμή ένα εκατοστό."},
    {"start":38.604,"end":39.964,"text":"Το λέμε και μιλιλίτρο."},
    {"start":40.964,"end":45.812,"text":"Για τα υγρά χρησιμοποιούμε συχνά το λίτρο. Ένα λίτρο είναι χίλια κυβικά εκατοστά."},
    {"start":47.312,"end":51.056,"text":"Πώς μετράμε τον όγκο μιας πέτρας, που έχει ακανόνιστο σχήμα;"},
    {"start":52.256,"end":57.824,"text":"Παίρνουμε ένα ογκομετρικό δοχείο, δηλαδή ένα διαφανές δοχείο με γραμμές που δείχνουν τον όγκο."},
    {"start":58.824,"end":61.528,"text":"Βάζουμε νερό ώς τα εκατό κυβικά εκατοστά."},
    {"start":62.528,"end":64.736,"text":"Βυθίζουμε την πέτρα μέσα στο νερό."},
    {"start":65.736,"end":69.592,"text":"Η πέτρα παίρνει χώρο, και το νερό ανεβαίνει ώς τα εκατόν τριάντα."},
    {"start":70.792,"end":73.656,"text":"Το νερό ανέβηκε τριάντα κυβικά εκατοστά."},
    {"start":74.456,"end":80.296,"text":"Άρα ο όγκος της πέτρας είναι εκατόν τριάντα μείον εκατό, δηλαδή τριάντα κυβικά εκατοστά."},
    {"start":82.096,"end":84.752,"text":"Ο όγκος των στερεών και των υγρών δεν αλλάζει."},
    {"start":85.752,"end":89.464,"text":"Το σχήμα των υγρών όμως αλλάζει: παίρνουν το σχήμα του δοχείου τους."},
    {"start":90.464,"end":94.896,"text":"Το ίδιο νερό σε ψηλό ποτήρι, σε μπολ ή σε πιάτο έχει τον ίδιο όγκο."},
    {"start":96.396,"end":100.556,"text":"Τα αέρια γεμίζουν όλο το δοχείο που τα κλείνει, και ο όγκος τους αλλάζει."},
    {"start":102.056,"end":105.32,"text":"Θυμήσου: όγκος είναι ο χώρος που παίρνει ένα σώμα."},
    {"start":106.32,"end":110.416,"text":"Μπράβο σου! Τώρα έλα να λύσεις τις ασκήσεις."}
  ]
}
