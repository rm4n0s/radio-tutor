  "captions": [
    {"start":0.5,"end":3.492,"text":"Δες μια τραμπάλα με ένα μεγάλο και ένα μικρό παιδί."},
    {"start":3.892,"end":6.436,"text":"Η τραμπάλα γέρνει προς το μεγάλο παιδί."},
    {"start":7.236,"end":12.884,"text":"Γιατί; Γιατί το μεγάλο παιδί έχει περισσότερη ύλη, δηλαδή μεγαλύτερη μάζα."},
    {"start":13.884,"end":16.636,"text":"Η μάζα ενός σώματος μάς λέει πόση ύλη έχει."},
    {"start":17.436,"end":19.692,"text":"Κάθε υλικό σώμα έχει μάζα."},
    {"start":20.692,"end":24.628,"text":"Η βασική μονάδα της μάζας είναι το χιλιόγραμμο, που το λέμε και κιλό."},
    {"start":25.628,"end":30.828,"text":"Για μικρότερες μάζες χρησιμοποιούμε το γραμμάριο. Ένα κιλό είναι χίλια γραμμάρια."},
    {"start":32.028,"end":36.876,"text":"Για πολύ μεγάλες μάζες χρησιμοποιούμε τον τόνο. Ένας τόνος είναι χίλια κιλά."},
    {"start":38.376,"end":41.912,"text":"Στη συσκευασία των προϊόντων γράφει πάντα τη μάζα τους."},
    {"start":43.412,"end":48.052,"text":"Πώς μετράμε τη μάζα; Τη συγκρίνουμε με σώματα που ξέρουμε τη μάζα τους."},
    {"start":48.852,"end":51.028,"text":"Αυτά τα σώματα λέγονται σταθμά."},
    {"start":51.828,"end":55.188,"text":"Το όργανο που χρησιμοποιούμε λέγεται ζυγός σύγκρισης."},
    {"start":56.388,"end":59.988,"text":"Βάζουμε ένα πακέτο στον έναν δίσκο. Αυτός ο δίσκος κατεβαίνει."},
    {"start":61.188,"end":65.268,"text":"Στον άλλο δίσκο βάζουμε σταθμά, μέχρι να ισορροπήσει ο ζυγός."},
    {"start":67.768,"end":70.936,"text":"Ο ζυγός ισορροπεί, όταν οι δύο μάζες είναι ίσες."},
    {"start":71.936,"end":75.904,"text":"Εδώ έχουμε σταθμά των πεντακοσίων και των διακοσίων γραμμαρίων."},
    {"start":76.704,"end":79.536,"text":"Άρα το πακέτο έχει μάζα επτακόσια γραμμάρια."},
    {"start":80.736,"end":83.872,"text":"Η μάζα ενός σώματος δεν αλλάζει, όπου κι αν το πας."},
    {"start":84.872,"end":91.976,"text":"Από το χίλια οκτακόσια εβδομήντα πέντε, όλος ο κόσμος συγκρίνει τις μάζες με ένα πρότυπο χιλιόγραμμο, που φυλάσσεται στο Παρίσι."},
    {"start":92.976,"end":97.136,"text":"Είναι φτιαγμένο από πλατίνα και ιρίδιο, και το προσέχουν πολύ."},
    {"start":98.336,"end":104.32,"text":"Στην αρχαία Αθήνα, ένα κτίριο της Αρχαίας Αγοράς, ο Θόλος, φύλαγε τα πρότυπα σταθμά."},
    {"start":105.82,"end":109.868,"text":"Θυμήσου: η μάζα μάς λέει πόση ύλη έχει ένα σώμα."},
    {"start":110.868,"end":115.748,"text":"Μπράβο σου! Τώρα, στις ασκήσεις!"}
  ]
}
