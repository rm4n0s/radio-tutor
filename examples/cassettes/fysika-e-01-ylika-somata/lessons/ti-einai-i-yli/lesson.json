  "captions": [
    {"start":0.5,"end":3.908,"text":"Κοίτα γύρω σου! Παντού υπάρχει ύλη."},
    {"start":4.308,"end":9.108,"text":"Η πέτρα, το νερό, ο αέρας και το λουλούδι είναι φτιαγμένα από ύλη."},
    {"start":9.508,"end":12.068,"text":"Κι εσύ ο ίδιος αποτελείσαι από ύλη!"},
    {"start":12.868,"end":16.82,"text":"Κάθε πράγμα που είναι φτιαγμένο από ύλη, το λέμε υλικό σώμα."},
    {"start":17.62,"end":23.62,"text":"Από πολύ παλιά, οι άνθρωποι χρησιμοποιούν την ύλη για φαγητό, ρούχα, σπίτια και εργαλεία."},
    {"start":24.42,"end":28.5,"text":"Μόνο στο κενό, εκεί που δεν υπάρχει τίποτα, δεν υπάρχει ύλη."},
    {"start":29.5,"end":32.748,"text":"Τα υλικά σώματα είναι στερεά, υγρά ή αέρια."},
    {"start":33.548,"end":34.972,"text":"Η πέτρα είναι στερεό."},
    {"start":35.772,"end":37.164,"text":"Το νερό είναι υγρό."},
    {"start":37.964,"end":40.3,"text":"Ο αέρας μέσα στο μπαλόνι είναι αέριο."},
    {"start":41.3,"end":45.108,"text":"Τι θα βρεις, αν κόψεις την ύλη σε όλο και πιο μικρά κομμάτια;"},
    {"start":47.308,"end":51.996,"text":"Πριν από δυόμισι χιλιάδες χρόνια, ο Έλληνας σοφός Δημόκριτος το σκέφτηκε."},
    {"start":52.396,"end":55.692,"text":"Είπε ότι θα φτάσεις σε ένα κομματάκι που δεν κόβεται άλλο."},
    {"start":56.492,"end":59.996,"text":"Το ονόμασε άτομο, δηλαδή αυτό που δεν κόβεται."},
    {"start":61.196,"end":65.948,"text":"Σήμερα ξέρουμε ότι η ύλη αποτελείται από μικροσκοπικά σωματίδια, τα μόρια."},
    {"start":67.148,"end":71.964,"text":"Είναι τόσο μικρά, που δισεκατομμύρια χωράνε στο κεφάλι μιας καρφίτσας!"},
    {"start":73.164,"end":76.732,"text":"Κάθε μόριο αποτελείται από ακόμα μικρότερα σωματίδια, τα άτομα."},
    {"start":77.932,"end":82.172,"text":"Το μόριο του νερού έχει δύο άτομα υδρογόνου και ένα άτομο οξυγόνου."},
    {"start":83.972,"end":87.444,"text":"Στη φύση υπάρχουν μόνο ενενήντα δύο είδη ατόμων."},
    {"start":88.444,"end":94.3,"text":"Είναι σαν τα τουβλάκια: με λίγα είδη φτιάχνεις χιλιάδες διαφορετικές κατασκευές."},
    {"start":95.8,"end":99.176,"text":"Τα μόρια δεν ησυχάζουν ποτέ. Κινούνται συνεχώς."},
    {"start":100.176,"end":104.784,"text":"Στα στερεά, τα μόρια είναι κολλητά και κουνιούνται λίγο στην ίδια θέση."},
    {"start":106.284,"end":110.828,"text":"Στα υγρά, τα μόρια είναι κοντά, αλλά γλιστράνε και αλλάζουν θέσεις."},
    {"start":112.328,"end":116.216,"text":"Στα αέρια, τα μόρια πετούν ελεύθερα και απέχουν πολύ το ένα από το άλλο."},
    {"start":117.716,"end":121.876,"text":"Μπράβο σου! Τώρα δοκίμασε τις ασκήσεις."}
  ]
}
