  "captions": [
    {"start":0.5,"end":2.39,"text":"Here is a square cake."},
    {"start":2.79,"end":5.749,"text":"Four friends want to share it fairly."},
    {"start":6.149,"end":11.033,"text":"First we cut it in half, then we cut each half in half again."},
    {"start":12.033,"end":14.465,"text":"Now there are four equal pieces."},
    {"start":14.865,"end":17.528,"text":"Each piece is called one quarter."},
    {"start":18.528,"end":22.422,"text":"We write one quarter like this: one over four."},
    {"start":23.922,"end":27.816,"text":"One quarter plus two quarters makes three quarters."}
  ]
