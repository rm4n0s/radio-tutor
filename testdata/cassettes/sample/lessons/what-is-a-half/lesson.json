  "captions": [
    {"start":0.5,"end":2.525,"text":"Look, a yummy pizza!"},
    {"start":2.925,"end":5.834,"text":"Two friends want to share it fairly."},
    {"start":6.234,"end":9.07,"text":"So we cut it into two equal pieces."},
    {"start":10.27,"end":13.437,"text":"Both pieces are exactly the same size."},
    {"start":13.837,"end":16.315,"text":"Each piece is called one half."},
    {"start":17.315,"end":20.939,"text":"We write one half like this: one over two."},
    {"start":22.439,"end":25.181,"text":"Two halves make one whole pizza!"}
